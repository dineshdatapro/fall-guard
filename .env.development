# Local demo defaults. These are placeholders, not secrets.
# `npm run dev` tries the Firestore emulator and keeps events in the browser if it is down.
# Override any line in .env.local when you connect a real Firebase project.

VITE_FIREBASE_API_KEY=demo
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-kinalert
VITE_FIREBASE_STORAGE_BUCKET=demo-kinalert.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8099
